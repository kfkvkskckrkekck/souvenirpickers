# Live Streaming Configuration
# Copy this file to .env and add your actual credentials

# ============================================
# OPTION 1: AGORA (Recommended for Production)
# ============================================
# Sign up at: https://console.agora.io/
# Get App ID from project settings
# Get App Certificate from project settings (enable it first)

VITE_AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# Note: AGORA_APP_CERTIFICATE should be added to Supabase Edge Functions
# environment variables, not exposed to frontend


# ============================================
# OPTION 2: DAILY.CO (Fastest Setup)
# ============================================
# Sign up at: https://dashboard.daily.co/signup
# Get API key from: https://dashboard.daily.co/developers

VITE_DAILY_API_KEY=your_daily_api_key_here

# Note: For security, add this to Supabase Edge Functions
# environment variables instead of frontend


# ============================================
# OPTION 3: TWILIO VIDEO
# ============================================
# Sign up at: https://www.twilio.com/try-twilio
# Get credentials from: https://console.twilio.com/

VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid
VITE_TWILIO_API_KEY=your_twilio_api_key
VITE_TWILIO_API_SECRET=your_twilio_api_secret

# Note: TWILIO_API_SECRET should be in Supabase Edge Functions only


# ============================================
# STREAMING PROVIDER SELECTION
# ============================================
# Set which provider to use: 'agora', 'daily', 'twilio', or 'custom'

VITE_STREAMING_PROVIDER=agora


# ============================================
# OPTIONAL: STREAMING CONFIGURATION
# ============================================

# Maximum stream duration in minutes (default: 180 = 3 hours)
VITE_MAX_STREAM_DURATION=180

# Default video quality: 'low' (480p), 'medium' (720p), 'high' (1080p)
VITE_DEFAULT_STREAM_QUALITY=medium

# Enable/disable stream recording (true/false)
VITE_ENABLE_STREAM_RECORDING=false


# ============================================
# SUPABASE EDGE FUNCTIONS ENVIRONMENT VARIABLES
# ============================================
# These should be added in Supabase Dashboard:
# Project Settings > Edge Functions > Environment Variables
#
# For Agora:
#   - AGORA_APP_ID
#   - AGORA_APP_CERTIFICATE
#
# For Daily.co:
#   - DAILY_API_KEY
#
# For Twilio:
#   - TWILIO_ACCOUNT_SID
#   - TWILIO_API_KEY
#   - TWILIO_API_SECRET
